# Environment Variables

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/axa_ecom_db?schema=public"

# JWT
JWT_SECRET="axa_industries_super_secret_jwt_key_2026_prod"
JWT_REFRESH_SECRET="axa_industries_super_secret_jwt_refresh_key_2026_prod"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cloudinary credentials — see Stage 4 instructions for how to use this file
# Server-side and MCP environment variables (never expose API secret in browser code)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Client-side (Next.js / Browser) — safe to expose cloud name publicly for frontend image rendering
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name


# SMTP / Email
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="smtp_user"
SMTP_PASSWORD="replace_with_provider_credential"
SMTP_FROM="notifications@your-verified-domain.example"
SMTP_REPLY_TO="sales@your-domain.example"
ADMIN_NOTIFICATION_EMAIL="hyperhimesh@gmail.com,axaindustries.contact@gmail.com,axaindustries1@gmail.com"

# App Ports & URLs
PORT=4000
API_URL="http://localhost:4000"
ADMIN_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"

# Browser-facing API base URL for both the storefront and admin deployments.
# Set this separately in each frontend's deployment environment; it must point to the backend /api endpoint.
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
