# Environment Variables

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/axa_ecom_db?schema=public"

# JWT
JWT_SECRET="axa_industries_super_secret_jwt_key_2026_prod"
JWT_REFRESH_SECRET="axa_industries_super_secret_jwt_refresh_key_2026_prod"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cloudinary
CLOUDINARY_CLOUD_NAME="axa-cloud"
CLOUDINARY_API_KEY="1234567890"
CLOUDINARY_SECRET="cloudinary_secret_key"

# SMTP / Email
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="smtp_user"
SMTP_PASSWORD="smtp_password"
SMTP_FROM="noreply@axaindustries.com"

# App Ports & URLs
PORT=4000
API_URL="http://localhost:4000"
ADMIN_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
