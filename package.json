{
  "name": "axa-industries-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npx pnpm turbo build",
    "dev": "npx pnpm turbo dev",
    "lint": "npx pnpm turbo lint",
    "format": "npx prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "npx prisma@5.18.0 generate --schema=packages/db/prisma/schema.prisma",
    "db:push": "npx prisma@5.18.0 db push --schema=packages/db/prisma/schema.prisma",
    "db:seed": "npx tsx packages/db/prisma/seed.ts"
  },
  "packageManager": "pnpm@9.7.0",
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.0.12",
    "typescript": "^5.5.4"
  },

  "engines": {
    "node": ">=18.0.0"
  }
}
