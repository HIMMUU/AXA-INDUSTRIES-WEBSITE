# ==============================================================================
# AXA INDUSTRIES STOREFRONT (FRONTEND) ENVIRONMENT VARIABLES
# ==============================================================================
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# DO NOT place backend database URLs, JWT keys, or SMTP passwords in this file.

# 1. Backend REST API Base URL (must point to the /api endpoint of the backend)
# Local Development:
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
# Production (Vercel):
# NEXT_PUBLIC_API_URL="https://axa-industries-website-api.vercel.app/api"

# 2. Cloudinary Media Delivery
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="j0f3i5re"

# 3. Storefront Canonical URL (Used for SEO, Metadata, & OpenGraph)
# Local Development:
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Production (Vercel):
# NEXT_PUBLIC_SITE_URL="https://axa-industries-website-web.vercel.app"

# 4. Official Contact & Support Information
NEXT_PUBLIC_SUPPORT_PHONE="+91 85951 56873"
NEXT_PUBLIC_SUPPORT_EMAIL="axaclub1@gmail.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="918595156873"

# 5. Optional, consent-gated site analytics
# Google Ads base tag uses account AW-18521031754.
# Analytics and attribution remain disabled until a visitor accepts analytics.
# NEXT_PUBLIC_GA4_MEASUREMENT_ID="G-XXXXXXXXXX"
# Lead conversion events also require the conversion label from Google Ads.
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL="your_conversion_label"

# 6. Optional product demo media (publicly accessible H.264 MP4, WebP poster, English VTT captions)
# NEXT_PUBLIC_REEL_1_MP4="https://media.example/reel-1.mp4"
# NEXT_PUBLIC_REEL_1_POSTER="https://media.example/reel-1-poster.webp"
# NEXT_PUBLIC_REEL_1_CAPTIONS="https://media.example/reel-1.en.vtt"
# NEXT_PUBLIC_REEL_2_MP4="https://media.example/reel-2.mp4"
# NEXT_PUBLIC_REEL_2_POSTER="https://media.example/reel-2-poster.webp"
# NEXT_PUBLIC_REEL_2_CAPTIONS="https://media.example/reel-2.en.vtt"
