# Transactional enquiry email delivery via authenticated SMTP.
# Use the SMTP host, port, username, and credential issued by your chosen mail provider.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="smtp_user"
SMTP_PASSWORD="replace_with_provider_credential"

# The From domain must be verified with the email provider.
SMTP_FROM="notifications@your-verified-domain.example"
SMTP_REPLY_TO="sales@your-domain.example"
ADMIN_NOTIFICATION_EMAIL="hyperhimesh@gmail.com,axaindustries.contact@gmail.com,axaindustries1@gmail.com"
